<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>To-Do Application</title>
    <style>
        :root {
            --bg-body: #f4f6f8;
            --bg-container: #ffffff;
            --bg-item: #ffffff;
            --bg-empty: #fafafa;
            --text-main: #333333;
            --text-header: #1a1a1a;
            --text-muted: #888888;
            --border-color: #e5e7eb;
            --border-hover: #cbd5e1;
            --input-bg: #ffffff;
            --btn-logout-bg: #f0f2f5;
            --btn-logout-text: #444444;
            --btn-small-bg: #ffffff;
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        [data-theme="dark"] {
            --bg-body: #0f172a;
            --bg-container: #1e293b;
            --bg-item: #334155;
            --bg-empty: #1e293b;
            --text-main: #f1f5f9;
            --text-header: #ffffff;
            --text-muted: #94a3b8;
            --border-color: #475569;
            --border-hover: #64748b;
            --input-bg: #0f172a;
            --btn-logout-bg: #334155;
            --btn-logout-text: #e2e8f0;
            --btn-small-bg: #1e293b;
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
        }

        body {
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            padding: 40px 16px;
        }

        .container {
            width: 100%;
            max-width: 580px;
            background: var(--bg-container);
            border-radius: 12px;
            box-shadow: var(--shadow);
            padding: 28px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 24px;
        }

        .header h2 {
            font-size: 1.6rem;
            color: var(--text-header);
            font-weight: 700;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.95rem;
            color: var(--text-muted);
        }

        .btn-theme {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 6px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1rem;
        }

        .btn-theme:hover {
            border-color: var(--border-hover);
        }

        .btn-logout {
            background-color: var(--btn-logout-bg);
            color: var(--btn-logout-text);
            border: 1px solid var(--border-color);
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
        }

        .error {
            background-color: #fef2f2;
            border-left: 4px solid #ef4444;
            color: #991b1b;
            padding: 10px 14px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }

        .add-form {
            display: flex;
            gap: 10px;
            margin-bottom: 24px;
        }

        .add-form input[type="text"] {
            flex-grow: 1;
            padding: 10px 14px;
            border: 1px solid var(--border-color);
            background-color: var(--input-bg);
            color: var(--text-main);
            border-radius: 8px;
            font-size: 0.95rem;
            outline: none;
        }

        .add-form input[type="text"]:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.25);
        }

        .btn-primary {
            background-color: #2563eb;
            color: #ffffff;
            border: none;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
        }

        .btn-primary:hover {
            background-color: #1d4ed8;
        }

        .empty-state {
            text-align: center;
            padding: 32px 16px;
            color: var(--text-muted);
            font-size: 0.95rem;
            background-color: var(--bg-empty);
            border: 1px dashed var(--border-color);
            border-radius: 8px;
        }

        .todo-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .todo-item {
            display: flex;
            align-items: center;
            gap: 10px;
            background-color: var(--bg-item);
            padding: 8px 12px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
        }

        .todo-checkbox {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #2563eb;
        }

        .edit-form {
            display: flex;
            flex-grow: 1;
            gap: 6px;
        }

        .todo-title {
            width: 100%;
            padding: 6px 10px;
            border: 1px solid transparent;
            border-radius: 6px;
            font-size: 0.95rem;
            color: var(--text-main);
            background: transparent;
        }

        .todo-title:focus {
            border-color: #3b82f6;
            background-color: var(--input-bg);
            outline: none;
        }

        .todo-title.done {
            text-decoration: line-through;
            color: var(--text-muted);
        }

        .btn-small {
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            border: 1px solid var(--border-color);
            background-color: var(--btn-small-bg);
            color: var(--text-main);
        }

        .btn-delete {
            border-color: #fca5a5;
            color: #dc2626;
            background-color: transparent;
        }

        .btn-delete:hover {
            background-color: #fee2e2;
            color: #991b1b;
        }

        @media (max-width: 480px) {
            body { padding: 16px 8px; }
            .container { padding: 18px; }
            .header h2 { font-size: 1.3rem; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h2>To-Do</h2>
            <div class="user-info">
                <button type="button" class="btn-theme" id="themeToggle" title="Toggle Dark/Light Mode">🌙</button>
                <span>Hi, <%= userName %></span>
                <form action="/logout" method="POST" style="display:inline;">
                    <button type="submit" class="btn-logout">Log out</button>
                </form>
            </div>
        </div>

        <% if (errors && errors.length > 0) { %>
            <div class="error">
                <% errors.forEach(error => { %>
                    <p><%= error %></p>
                <% }) %>
            </div>
        <% } %>

        <form action="/todos/add" method="POST" class="add-form" id="addForm">
            <input type="text" name="title" id="todoTitle" placeholder="What needs to be done?">
            <button type="submit" class="btn-primary">Add</button>
        </form>

        <% if (!todos || todos.length === 0) { %>
            <div class="empty-state">
                No tasks found. Add your first to-do item above!
            </div>
        <% } else { %>
            <div class="todo-list">
                <% todos.forEach(todo => { %>
                    <div class="todo-item">
                        <form action="/todos/toggle" method="POST" style="display:inline;">
                            <input type="hidden" name="todo_id" value="<%= todo.todo_id %>">
                            <input type="hidden" name="is_done" value="<%= todo.is_done %>">
                            <input type="checkbox" class="todo-checkbox" onChange="this.form.submit()" <%= todo.is_done ? 'checked' : '' %>>
                        </form>

                        <form action="/todos/edit" method="POST" class="edit-form">
                            <input type="hidden" name="todo_id" value="<%= todo.todo_id %>">
                            <input type="text" name="title" value="<%= todo.title %>" class="todo-title <%= todo.is_done ? 'done' : '' %>">
                            <button type="submit" class="btn-small">Save</button>
                        </form>

                        <form action="/todos/delete" method="POST" onsubmit="return confirm('Are you sure?');">
                            <input type="hidden" name="todo_id" value="<%= todo.todo_id %>">
                            <button type="submit" class="btn-small btn-delete">Delete</button>
                        </form>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

    <script>
        const themeToggleBtn = document.getElementById('themeToggle');
        const currentTheme = localStorage.getItem('theme');

        if (currentTheme) {
            document.documentElement.setAttribute('data-theme', currentTheme);
            themeToggleBtn.textContent = currentTheme === 'dark' ? '☀️' : '🌙';
        }

        themeToggleBtn.addEventListener('click', () => {
            let theme = document.documentElement.getAttribute('data-theme');
            if (theme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'light');
                localStorage.setItem('theme', 'light');
                themeToggleBtn.textContent = '🌙';
            } else {
                document.documentElement.setAttribute('data-theme', 'dark');
                localStorage.setItem('theme', 'dark');
                themeToggleBtn.textContent = '☀️';
            }
        });

        document.getElementById('addForm').addEventListener('submit', function(e) {
            const title = document.getElementById('todoTitle').value.trim();
            if (!title) { alert('Title is required'); e.preventDefault(); return; }
            if (title.length > 200) { alert('Title is too long'); e.preventDefault(); return; }
        });
    </script>
</body>
</html>